    "render:portrait": "remotion render Showcase-Portrait out/showcase-portrait.mp4",
    "still": "remotion still Showcase-Landscape out/showcase.png --frame=200",
    "new": "node scripts/new-composition.mjs",
    "audio": "node scripts/make-sample-audio.mjs",
    "build": "remotion bundle",
